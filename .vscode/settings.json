{
  "css.customData": [".vscode/tailwind.json"],
  "editor.quickSuggestions": {
    "strings": "on"
  },
  "tailwindCSS.includeLanguages": {
    "html": "html",
    "javascript": "javascript"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "tailwindCSS.experimental.classRegex": [
    // ← patterns pour détecter les classes dans le JS
    ["classList\\.add\\(([^)]*)\\)", "'([^']*)'"],
    ["classList\\.add\\(([^)]*)\\)", "\"([^\"]*)\""]
  ]
}
